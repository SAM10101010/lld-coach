# Copy to .env and fill in. Never commit real secrets.
DATABASE_URL=sqlite:///./lldcoach.db
# Provider selection: auto | openai | openrouter | heuristic
AI_PROVIDER=auto
OPENAI_API_KEY=
# OpenRouter (OpenAI-compatible). Example model: nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
CORS_ORIGINS=*
